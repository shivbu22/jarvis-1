# Jarvis configuration. Copy to .env  (setup.ps1 does this for you).
# Every value here already has the same default baked into apps/gateway/config.py,
# so an unedited copy of this file changes nothing -- it exists to be edited.
#
# .env is gitignored. Never commit real keys or an app password.

# ---------------------------------------------------------------------------
# Brain: who does the thinking
# ---------------------------------------------------------------------------
# auto  = relay when one is configured, else Gemini when GEMINI_API_KEY is set,
#         otherwise Ollama (recommended)
# relay | gemini | ollama | groq force one, with the others as fallbacks
JARVIS_BRAIN=auto

# Local model relay -- the big brain that costs no VRAM.
#
# An OpenAI-compatible server on loopback that fronts large hosted models. It is
# preferred over the local model when configured, and the difference is not subtle:
# measured here, a greeting took the local 3B brain 16 seconds and the relay 1.5,
# and the relay calls tools natively instead of writing {"name": ...} as prose for
# the gateway to recover. Set JARVIS_BRAIN=ollama to stay on the local model, or
# JARVIS_OFFLINE=1 to forbid the relay entirely.
#
# The URL is the whole credential: relays of this kind embed the key in the path.
# Jarvis only ever speaks or logs the host (127.0.0.1:20128), never the path.
# JARVIS_RELAY_URL=http://127.0.0.1:20128/api/v1/vscode/sk-your-key-here
# JARVIS_RELAY_KEY=            # only if the relay wants a normal bearer token
# JARVIS_RELAY_MODEL=claude-haiku-4.5
# JARVIS_RELAY_TIMEOUT_SECONDS=60
# JARVIS_RELAY_MAX_TOKENS=0    # 0 = no cap; a cap truncates reasoning models mid-thought

# Local brain. Ollama must be running: 'ollama serve'.
OLLAMA_HOST=http://127.0.0.1:11434
#
# llama3.2:3b is the default: measured on this machine it answers in 1-4 seconds per
# model call where qwen3:4b takes 24-28, because qwen3 reasons at length before it
# speaks. For a spoken assistant the wait IS the product, so fast wins.
# qwen3:4b is the deeper brain for hard multi-step questions -- expect the wait.
#
# Either way, leave the stock name here: Jarvis prefers the tuned variant
# automatically when it exists (8k context instead of Ollama's 65536 default,
# which is what makes a stock model four times slower on this GPU):
#   llama3.2:3b -> jarvis-brain:3b     qwen3:4b -> jarvis-brain:4b
# scripts\setup.ps1 creates both from config\ollama\Modelfile.*
OLLAMA_MODEL=llama3.2:3b

# Last-resort brain that runs *inside* the gateway, with no Ollama in the path. It
# borrows the GGUF Ollama already downloaded and loads it read-only. Ollama is the
# only thing standing between Jarvis and silence if it ever fails to start -- which
# happened here -- so this is the seatbelt. Skipped automatically when the library
# or the weights are absent.
#
#   uv pip install --extra-index-url https://abetlen.github.io/llama-cpp-python/whl/cpu llama-cpp-python
#
# Measured caveat: it answers questions from what it knows, but tool calls through
# it are best-effort (llama-cpp-python has no qwen3 tool handler), so it is not a
# substitute for a working Ollama.
JARVIS_LOCAL_FALLBACK=1
# JARVIS_GGUF_PATH=            # a specific .gguf; wins over the Ollama store
# JARVIS_FALLBACK_CTX=8192
# JARVIS_FALLBACK_GPU_LAYERS=-1

# Cloud brain. Optional: without a key Jarvis runs entirely locally.
# GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# Optional second cloud fallback, used only if Gemini fails.
# GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile

# true = only local brains, local speech, nothing leaves this machine.
JARVIS_OFFLINE=0

# ---------------------------------------------------------------------------
# Hearing: faster-whisper
# ---------------------------------------------------------------------------
WHISPER_MODEL=small.en

# cuda | cpu | auto. Verified on this machine: CUDA *constructs* fine and then
# fails at the first encode with "cublas64_12.dll is not found", so Jarvis probes
# the device at load and falls back to CPU automatically. Leave this on cuda --
# the fallback is automatic and logged -- or set cpu to skip the attempt.
STT_DEVICE=cuda
STT_COMPUTE_TYPE=auto          # auto -> int8_float16 on cuda, int8 on cpu

STT_PROFILE=fast               # fast | balanced | accurate
STT_LANGUAGE=en                # 'auto' to let whisper detect
STT_VAD_FILTER=1

# ---------------------------------------------------------------------------
# Speaking: the cloned Jarvis voice
# ---------------------------------------------------------------------------
# auto = chatterbox when its model is already local, else the Windows voice.
TTS_ENGINE=auto                # auto | chatterbox | sapi
TTS_DEVICE=cpu                 # measured 2026-09-17: CUDA voice is 3x faster (2.5-3.3s
                               # vs 7.4-9.0s) but brain turns slow 14-19s -> 19-31s and VRAM
                               # ends at 3.8/4.0 GB with Ollama resident. On a 4 GB card the
                               # total spoken latency is the same; keep the headroom. Try cuda
                               # only if the brain runs on CPU or the GPU has > 6 GB.
TTS_BACKEND=turbo              # turbo | full  (turbo is the lighter model)
TTS_EXAGGERATION=0.5
TTS_MAX_CHARS=600

# The cloned voice needs a ~1.5 GB model download. It is OFF so that a spoken
# reply can never silently become a five-minute wait. Run
# 'python scripts/build_jarvis_voice.py' to fetch it deliberately, or set this
# to 1 to allow the download on first use.
TTS_ALLOW_DOWNLOAD=0

# ---------------------------------------------------------------------------
# Wake word: "Hey Jarvis" (local, CPU, no account)
# ---------------------------------------------------------------------------
WAKE_ENABLED=1
WAKE_MODEL=hey_jarvis
WAKE_THRESHOLD=0.5

# ---------------------------------------------------------------------------
# Safety
# ---------------------------------------------------------------------------
# How long a held action waits for a yes before it is treated as a no.
CONFIRM_TIMEOUT_SECONDS=30

# How long a question Jarvis asks waits for an answer before the turn carries on
# with a stated assumption. The whole turn is suspended for this window, so it is
# deliberately short: an unnecessary question costs this much and no more.
QUESTION_TIMEOUT_SECONDS=45
MAX_TOOL_ITERATIONS=6          # tool rounds per turn before Jarvis must answer
HISTORY_TURNS=12               # conversation turns kept as context
AUDIT_ENABLED=1                # append every decision to data/audit.jsonl
POLICY_PATH=config/policy.yaml # tiers, deny patterns, shell jail, app aliases

# ---------------------------------------------------------------------------
# Browser control (playwright)
# ---------------------------------------------------------------------------
# msedge drives the Edge already installed on Windows -- no 150 MB download.
# chrome | chromium | none are the alternatives.
BROWSER_CHANNEL=msedge

# ---------------------------------------------------------------------------
# Mail (optional -- without these, the mail tools explain what to set)
# ---------------------------------------------------------------------------
# MAIL_ADDRESS=you@gmail.com
# MAIL_APP_PASSWORD=              # an APP password, not your account password
# MAIL_FROM_NAME=Your Name
# IMAP_HOST=imap.gmail.com
# IMAP_PORT=993
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=465

# ---------------------------------------------------------------------------
# External MCP servers
# ---------------------------------------------------------------------------
MCP_ENABLED=1
MCP_CONFIG_PATH=config/mcp_servers.yaml

# ---------------------------------------------------------------------------
# Server
# ---------------------------------------------------------------------------
# 3111/3112/8080 are already in use on this machine by other projects.
JARVIS_HOST=127.0.0.1
JARVIS_PORT=8000

# ---------------------------------------------------------------------------
# Storage -- keep the big regenerable things OUT of OneDrive
# ---------------------------------------------------------------------------
# These are set by setup.ps1/run.ps1; uncomment only to override.
# UV_PROJECT_ENVIRONMENT=C:\Users\ahiva\AppData\Local\Jarvis\venv
# HF_HOME=C:\Users\ahiva\.cache\huggingface
# PLAYWRIGHT_BROWSERS_PATH=C:\Users\ahiva\AppData\Local\Jarvis\ms-playwright
# JARVIS_DATA_DIR=                  # defaults to .\data
# JARVIS_VOICES_DIR=                # defaults to .\voices
# HF_HUB_DISABLE_SYMLINKS_WARNING=1 # silences the Windows symlink advisory
